# Lo script install-zimaos.sh genera automaticamente un valore casuale sicuro.
# Questo è il token tecnico di bootstrap; al primo accesso l'interfaccia chiede
# di creare una password separata per il login alla dashboard.
# Per la configurazione manuale si può usare /proc/sys/kernel/random/uuid.
# Non cambiare il token dopo aver salvato le credenziali, altrimenti sarà
# necessario reinserire la password del router.
DNS_SWITCHER_SESSION_TOKEN=CAMBIA-QUESTO-TOKEN-CON-ALMENO-32-CARATTERI

DNS_SWITCHER_PORT=8765
DNS_SWITCHER_DATA_PATH=/DATA/AppData/dns-switcher-pro
TZ=Europe/Rome
